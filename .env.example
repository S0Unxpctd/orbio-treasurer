# Orbio Treasurer — example env (S-03, docs/PRD-1.0-sprint.md §3/§4 T-3).
# Copy to .env.local (git-ignored) in the sandbox. So sets production values in Vercel/Supabase
# himself (CLAUDE.md #5, PROCESS.md §5) — never paste real values here, never commit .env.local.

# --- core (every agent) ---
LEDGER=sqlite
LEDGER_SQLITE_PATH=./treasurer.db
ORBIO_MCP_URL=https://www.orbio.so/api/mcp
ORBIO_GATEWAY_BASE_URL=https://api.orbio.so/api/v1
# Legacy static key (S-01). Only used if TREASURER_PRIVATE_KEY (below) is unset.
ORBIO_KEY=

# --- S-01: gateway + router ---
# Comma-separated otk_<32 hex> caller keys.
GATEWAY_KEYS=

# --- S-03: chain 4663 read + wallet-signed key (docs/PRD-1.0-sprint.md §3) ---
# Ordered RPC fallback list. Default (if unset) is exactly this: publicnode first (no documented
# rate limit), ordofi second. The official rpc.mainnet.chain.robinhood.com 429s after 2-3 calls —
# deliberately not used here; add it as a 3rd entry yourself if you want it as a last resort.
RH_RPC_URLS=https://robinhood-rpc.publicnode.com,https://rpc.ordofi.network

# Contract addresses on Robinhood Chain (id 4663) — PRD §3, verified live 2026-09-19 (see
# docs/api-notes.md "S-03 chain reads"). Never hard-code these in source (CLAUDE.md #5); read
# only through chain/contracts.ts's loadChainAddresses(), which checksum-validates them.
CREDIT_ADDRESS=0xe33322da1380e61e5ae5dfb21e7f62924c73004c
STAKING_ADDRESS=0xe0710011278bfb63e57c5f227e5980984b1eddca
EXCHANGE_ADDRESS=0x6951ffd32630b05e06f50062aea801625a58ebc0
PAYOUT_ADDRESS=0x4cbbbf652b11ed1294df0ac49d8322394310cfc5
ORBIO_ADDRESS=0xaa07a0e9209e16ac99708c3ec70159c6ef3128a3
# The PRD's own printed casing for this one has an incorrect checksum character (see
# docs/api-notes.md Discovered) — the value below is the correct EIP-55 checksum;
# loadChainAddresses() would re-checksum either casing to the same address either way.
USDG_ADDRESS=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
NVDA_ADDRESS=0xd0601CE157Db5bdC3162BbaC2a2C8aF5320D9EEC

# Wallet-signed Orbio API key (chain/key.ts's deriveOrbioKey). SECRET — never commit, never
# paste in chat, never print. When set, getUpstreamKey() derives sk-orb-0-<sig> from it instead
# of using the static ORBIO_KEY above. This is the Treasurer's own hot wallet.
TREASURER_PRIVATE_KEY=

# The wallet whose staking position (Staking.positionOf/settledOf) readTreasury() reads. Public
# address, not a secret — but optional: an unset value reads a well-formed zero-position
# snapshot instead of erroring (ticket AC1).
STAKER_ADDRESS=

# Only if the staking wallet is dedicated (ORBIO only) and So has provided it (PRD §9 Q1) — S-04
# uses this to automate settle -> claim -> activate. SECRET — never commit, paste, or print.
STAKER_PRIVATE_KEY=

# --- hosted only (Supabase-backed ledger) ---
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# DATABASE_URL=
