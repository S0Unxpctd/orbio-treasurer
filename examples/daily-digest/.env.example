# Orbio Treasurer gateway this agent calls (OpenAI-compatible /v1/chat/completions).
ORBIO_TREASURER_URL=https://<REFERENCE_HOST>

# Your API key (otk_...). Ask the Treasurer operator for one, or see README.md "Get a key".
# Never commit a real key here — copy this file to .env (git-ignored) and fill it in there.
ORBIO_TREASURER_KEY=

# Optional: 1-3 comma-separated RSS/Atom feed URLs. Defaults to two public tech feeds if unset.
#FEEDS=https://hnrss.org/frontpage,https://github.blog/feed/

# Optional: POST the digest text here (a Slack/Discord incoming webhook, a bin, etc.).
#DIGEST_WEBHOOK_URL=

# Optional: POST the digest here to publish it to X — no X SDK or X keys needed in this agent.
#X_WEBHOOK_URL=

# Optional: shown on the public page alongside this agent's registration.
#AGENT_REPO_URL=

# Optional: model id to compare cost against for the printed "vs baseline" line.
#BASELINE_MODEL=orbio/large-flagship
