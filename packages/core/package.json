{
  "name": "@orbio-treasurer/core",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && mkdir -p dist/ledger/sqlite && cp src/ledger/sqlite/schema.sql dist/ledger/sqlite/schema.sql",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p scripts/tsconfig.json --noEmit",
    "gen:sql": "tsx scripts/gen-sql.ts",
    "treasury:read": "tsx scripts/treasury-read.ts",
    "treasury:buy": "tsx scripts/treasury-buy.ts",
    "treasury:claim": "tsx scripts/treasury-claim.ts",
    "tick": "tsx scripts/tick.ts",
    "keys:create": "tsx scripts/keys-create.ts"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "postgres": "^3.4.9",
    "viem": "^2.56.8",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.13.3",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
